#!/usr/bin/env -S python3 -I
"""Build and manage Pixel Buddy sprite packs.

A pack is a folder in ~/.local/share/pixel-buddy/packs (outside the plugin, so writing there
never makes Omarchy reload its plugins). It holds any mix of:
  *.aseprite / *.ase   every tag is one animation; a file without tags is one animation named after it
  *.png + *.json       sprite sheet with an Aseprite/LibreSprite JSON export, or the simple format:
                       {"frameWidth": 128, "frameHeight": 72, "fps": 10,
                        "animations": {"idle": [0, 3], "walk": {"from": 4, "to": 11, "fps": 12}}}
  *.png alone          a horizontal strip of 16:9 (or square) frames, one animation named after the file
  *.gif / *.webp       one ready-made animation named after the file
plus an optional pack.json (name, role mapping, geometry; the bar widget writes it).

Builds go to ~/.cache/pixel-buddy/packs/<id>/ as animated WebP, padded to a 16:9 canvas
(bottom-centered), with a manifest of loop lengths and sprite bounds. ~/.cache/pixel-buddy/index.json
lists every pack for the shell.

Usage: pixel-buddy-pack init | index | build [ID…|--all] [--force] | new NAME | duplicate ID NAME
       | delete ID | save ID JSON | icons ID WAITING SUCCESS ERROR | aseprite ID | watch
       | template-png
template-png re-exports templates/buddy.aseprite as templates/buddy.png; run it after editing the template.
Set ASEPRITE=/path/to/aseprite if it isn't on PATH or in the Steam library.
"""

import fcntl
import getpass
import hashlib
import json
import math
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import time

try:
    from PIL import Image, ImageSequence
except ImportError:
    sys.exit("pixel-buddy-pack needs Pillow: omarchy pkg add python-pillow")

VERSION = 5  # bump when the build output changes, to rebuild every pack once
PLUGIN = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or HOME + "/.local/share", "pixel-buddy", "packs")
TRASH = os.path.join(os.path.dirname(DATA), "trash")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or HOME + "/.cache", "pixel-buddy")
BUILDS = os.path.join(CACHE, "packs")
INDEX = os.path.join(CACHE, "index.json")
TEMPLATE = os.path.join(PLUGIN, "templates", "buddy.aseprite")
# The same art as a PNG drawing (exported from TEMPLATE), for installs without Aseprite
TEMPLATE_PNG = os.path.join(PLUGIN, "templates", "buddy.png")
# The default pack's settings (name, geometry, phrases), copied with the template on first start
TEMPLATE_PACK = os.path.join(PLUGIN, "templates", "pack.json")
SOURCE_EXT = {".aseprite": "aseprite", ".ase": "aseprite", ".png": "sheet", ".gif": "gif", ".webp": "webp"}
ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")


class PackError(Exception):
    pass


# ------------------------------------------------------------------ helpers

def log(msg):
    print(msg, flush=True)


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def read_json(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


class Lock:
    """Serialises builds and index writes between the watcher and one-off commands."""

    def __init__(self, name):
        os.makedirs(CACHE, exist_ok=True)
        self.path = os.path.join(CACHE, "." + name + ".lock")

    def __enter__(self):
        self.fh = open(self.path, "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def find_aseprite():
    candidates = [os.environ.get("ASEPRITE"), shutil.which("aseprite"),
                  HOME + "/.local/share/Steam/steamapps/common/Aseprite/aseprite",
                  HOME + "/.steam/steam/steamapps/common/Aseprite/aseprite"]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def anim_file(name):
    """File name of a built animation. Escapes "/" (and "%", so "a/b" and "a%2Fb" stay apart):
    replacing "/" with "_" made "work/typing" and "work_typing" overwrite each other."""
    return name.replace("%", "%25").replace("/", "%2F") + ".webp"


def slugify(name):
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40]
    return s or "pack"


def unique_id(name):
    base = slugify(name)
    pid, n = base, 2
    while os.path.exists(os.path.join(DATA, pid)):
        pid, n = "%s-%d" % (base, n), n + 1
    return pid


def pack_dir(pid):
    if not ID_RE.match(pid or ""):
        raise PackError("bad pack id: %r" % pid)
    return os.path.join(DATA, pid)


def pack_ids():
    if not os.path.isdir(DATA):
        return []
    return sorted(d for d in os.listdir(DATA)
                  if ID_RE.match(d) and os.path.isdir(os.path.join(DATA, d)))


def sources(pid):
    d = pack_dir(pid)
    out = []
    for f in sorted(os.listdir(d)):
        if f.startswith(".") or f == "pack.json":
            continue
        ext = os.path.splitext(f)[1].lower()
        if ext in SOURCE_EXT and os.path.isfile(os.path.join(d, f)):
            out.append({"file": f, "format": SOURCE_EXT[ext]})
    return out


def stamp(pid):
    d = pack_dir(pid)
    parts = [VERSION]
    srcs = sources(pid)
    # Rebuild when Aseprite comes or goes, so frames kept from an unreadable file get replaced
    if any(s["format"] == "aseprite" for s in srcs):
        parts.append(["aseprite", bool(find_aseprite())])
    for s in srcs:
        stem = os.path.splitext(s["file"])[0]
        for f in (s["file"], stem + ".json"):
            p = os.path.join(d, f)
            if os.path.isfile(p):
                st = os.stat(p)
                parts.append([f, st.st_mtime_ns, st.st_size])
    return parts


def read_pack_json(pid):
    p = os.path.join(pack_dir(pid), "pack.json")
    if not os.path.isfile(p):
        return None, ""
    try:
        data = read_json(p)
        if not isinstance(data, dict):
            return None, "pack.json is not a JSON object"
        return data, ""
    except (OSError, ValueError) as e:
        return None, "pack.json: %s" % e


# ------------------------------------------------------------------ loading sources
# Every loader returns {animation name: (frames as RGBA images, durations in ms)}.

def frame_sequence(tag, count):
    a, b = int(tag.get("from", 0)), int(tag.get("to", count - 1))
    seq = list(range(a, b + 1))
    direction = tag.get("direction", "forward")
    if direction in ("reverse", "pingpong_reverse"):
        seq.reverse()
    if direction in ("pingpong", "pingpong_reverse") and len(seq) > 2:
        seq = seq + seq[-2:0:-1]
    try:
        repeat = int(tag.get("repeat") or 1)
    except ValueError:
        repeat = 1
    return seq * max(1, repeat)


def load_aseprite_json(sheet, data, stem):
    raw = data.get("frames", [])
    frames = list(raw.values()) if isinstance(raw, dict) else list(raw)
    if not frames:
        raise PackError("no frames in sheet data")
    images, durations = [], []
    for fr in frames:
        r = fr["frame"]
        img = sheet.crop((r["x"], r["y"], r["x"] + r["w"], r["y"] + r["h"]))
        if fr.get("rotated"):
            img = img.transpose(Image.Transpose.ROTATE_90)
        if fr.get("trimmed"):
            size, at = fr["sourceSize"], fr["spriteSourceSize"]
            full = Image.new("RGBA", (size["w"], size["h"]), (0, 0, 0, 0))
            full.paste(img, (at["x"], at["y"]))
            img = full
        images.append(img)
        durations.append(int(fr.get("duration") or 100))
    tags = (data.get("meta") or {}).get("frameTags") or []
    if not tags:
        return {stem: (images, durations)}
    out = {}
    for tag in tags:
        seq = [i for i in frame_sequence(tag, len(images)) if 0 <= i < len(images)]
        if seq and tag.get("name"):
            out[tag["name"]] = ([images[i] for i in seq], [durations[i] for i in seq])
    return out


def load_simple_sheet(sheet, data, stem):
    fw, fh = int(data["frameWidth"]), int(data["frameHeight"])
    cols = max(1, sheet.width // fw)
    rows = max(1, sheet.height // fh)
    default_ms = int(data.get("duration") or round(1000 / float(data.get("fps") or 10)))

    def cell(i):
        x, y = (i % cols) * fw, (i // cols) * fh
        return sheet.crop((x, y, x + fw, y + fh))

    anims = data.get("animations") or {stem: [0, int(data.get("frames") or cols * rows) - 1]}
    out = {}
    for name, spec in anims.items():
        if isinstance(spec, list):
            spec = {"from": spec[0], "to": spec[1]}
        if "row" in spec:
            spec = dict(spec, **{"from": int(spec["row"]) * cols})
            spec["to"] = spec["from"] + int(spec.get("frames") or cols) - 1
        seq = frame_sequence(spec, cols * rows)
        ms = spec.get("durations")
        if not isinstance(ms, list):
            one = int(spec.get("duration") or (round(1000 / float(spec["fps"])) if spec.get("fps") else default_ms))
            ms = [one] * len(seq)
        out[name] = ([cell(i) for i in seq], [int(ms[k % len(ms)]) for k in range(len(seq))])
    return out


def load_sheet(path):
    stem = os.path.splitext(os.path.basename(path))[0]
    sheet = Image.open(path).convert("RGBA")
    side = os.path.splitext(path)[0] + ".json"
    if os.path.isfile(side):
        data = read_json(side)
        if "frameWidth" in data:
            return load_simple_sheet(sheet, data, stem)
        return load_aseprite_json(sheet, data, stem)
    # No sidecar: a horizontal strip of 16:9 frames, else square frames, else one still image.
    h = sheet.height
    for fw in (round(h * 16 / 9), h):
        if fw and sheet.width % fw == 0:
            n = sheet.width // fw
            return {stem: ([sheet.crop((i * fw, 0, i * fw + fw, h)) for i in range(n)], [100] * n)}
    return {stem: ([sheet], [100])}


def load_animated(path):
    stem = os.path.splitext(os.path.basename(path))[0]
    img = Image.open(path)
    frames, durations = [], []
    for fr in ImageSequence.Iterator(img):
        frames.append(fr.convert("RGBA").copy())
        durations.append(int(fr.info.get("duration") or 100))
    return {stem: (frames, durations)}


def load_aseprite(path, ase, tmp):
    if not ase:
        raise PackError("needs Aseprite to build %s (set ASEPRITE=/path/to/aseprite)" % os.path.basename(path))
    stem = os.path.splitext(os.path.basename(path))[0]
    png, data = os.path.join(tmp, stem + ".png"), os.path.join(tmp, stem + ".json")
    r = subprocess.run([ase, "-b", path, "--sheet", png, "--sheet-type", "rows", "--data", data,
                        "--format", "json-array", "--list-tags"], capture_output=True, text=True)
    if r.returncode != 0 or not os.path.isfile(png):
        raise PackError("Aseprite could not export %s: %s" % (os.path.basename(path), (r.stderr or r.stdout).strip()))
    return load_aseprite_json(Image.open(png).convert("RGBA"), read_json(data), stem)


# ------------------------------------------------------------------ building

def build_pack(pid, force=False):
    """Export one pack into BUILDS/<id>. Returns True when something was built."""
    d = pack_dir(pid)
    out_dir = os.path.join(BUILDS, pid)
    man_path = os.path.join(out_dir, "manifest.json")
    st = stamp(pid)
    if not force and os.path.isfile(man_path):
        try:
            if read_json(man_path).get("stamp") == st:
                return False
        except (OSError, ValueError):
            pass
    errors, warnings, anims, origin = [], [], {}, {}
    failed = set()  # source files that couldn't be read; their last built frames are kept
    try:
        prev = read_json(man_path)
    except (OSError, ValueError):
        prev = {}
    ase = None
    with tempfile.TemporaryDirectory(prefix="pixel-buddy-") as tmp:
        for s in sources(pid):
            path = os.path.join(d, s["file"])
            try:
                if s["format"] == "aseprite":
                    ase = ase or find_aseprite()
                    loaded = load_aseprite(path, ase, tmp)
                elif s["format"] == "sheet":
                    loaded = load_sheet(path)
                else:
                    loaded = load_animated(path)
            except PackError as e:
                errors.append(str(e))
                failed.add(s["file"])
                continue
            except Exception as e:  # a broken file must not stop the rest of the pack
                errors.append("%s: %s" % (s["file"], e))
                failed.add(s["file"])
                continue
            for name, anim in loaded.items():
                if name in anims:
                    warnings.append("'%s' is in both %s and %s; %s wins" % (name, origin[name], s["file"], s["file"]))
                anims[name], origin[name] = anim, s["file"]

    staging = os.path.join(BUILDS, ".%s.%d" % (pid, os.getpid()))
    shutil.rmtree(staging, ignore_errors=True)
    built_at = int(time.time() * 1000)
    # A new folder per build: Qt keeps showing an image's old frames when a file at the same
    # path is replaced, so every build gets paths the shell has never loaded.
    webp_dir = "webp-%d" % built_at
    os.makedirs(os.path.join(staging, webp_dir))
    manifest = {"version": VERSION, "stamp": st, "builtAt": built_at, "webpDir": webp_dir,
                "canvas": None, "sourceCanvas": None, "animations": {}, "errors": errors, "warnings": warnings}
    if anims:
        w = max(f.width for fr, _ in anims.values() for f in fr)
        h = max(f.height for fr, _ in anims.values() for f in fr)
        # The buddy's physics assume a 16:9 box: pad the canvas out, keeping the feet on the bottom edge.
        k = max(math.ceil(w / 16), math.ceil(h / 9))
        cw, ch = (w, h) if w * 9 == h * 16 else (16 * k, 9 * k)
        if (cw, ch) != (w, h):
            warnings.append("canvas %dx%d is not 16:9; padded to %dx%d" % (w, h, cw, ch))
        manifest["canvas"], manifest["sourceCanvas"] = [cw, ch], [w, h]
        for name, (frames, durations) in anims.items():
            padded = []
            for f in frames:
                if f.size == (cw, ch):
                    padded.append(f)
                else:
                    full = Image.new("RGBA", (cw, ch), (0, 0, 0, 0))
                    full.paste(f, ((cw - f.width) // 2, ch - f.height))
                    padded.append(full)
            bounds = None
            for f in padded:
                b = f.getchannel("A").getbbox()
                if b:
                    bounds = list(b) if not bounds else [min(bounds[0], b[0]), min(bounds[1], b[1]),
                                                         max(bounds[2], b[2]), max(bounds[3], b[3])]
            path = os.path.join(staging, webp_dir, anim_file(name))
            if len(padded) == 1:
                padded[0].save(path, lossless=True)
            else:
                # Every frame a whole-canvas keyframe (kmax=1): Qt's WebP reader ignores frame
                # disposal, so a smaller patch frame leaves the previous frame showing around it
                padded[0].save(path, save_all=True, append_images=padded[1:], duration=durations,
                               loop=0, lossless=True, minimize_size=False, kmin=0, kmax=1)
            # Fingerprint of the frames, so the shell can tell which animations a save changed
            digest = hashlib.md5(repr(durations).encode())
            for f in padded:
                digest.update(f.tobytes())
            manifest["animations"][name] = {"ms": sum(durations), "frames": len(padded), "bounds": bounds,
                                            "source": origin[name], "hash": digest.hexdigest()[:16],
                                            "file": anim_file(name)}
    # Keep the last build of animations from files that couldn't be read this time (say Aseprite
    # was uninstalled), as long as the canvas is unchanged, instead of dropping them
    kept = {n: a for n, a in (prev.get("animations") or {}).items()
            if a.get("source") in failed and n not in manifest["animations"]}
    if kept and manifest["canvas"] in (None, prev.get("canvas")):
        manifest["canvas"] = prev.get("canvas")
        manifest["sourceCanvas"] = manifest["sourceCanvas"] or prev.get("sourceCanvas")
        for name, a in kept.items():
            old = os.path.join(out_dir, prev.get("webpDir") or "webp", a["file"])
            if os.path.isfile(old):
                shutil.copy2(old, os.path.join(staging, webp_dir, a["file"]))
                manifest["animations"][name] = a
        files = sorted({a["source"] for a in kept.values()})
        warnings.append("kept the last build of %s until it can be read again" % ", ".join(files))
    elif kept:
        warnings.append("the canvas size changed, so the last build of %s couldn't be kept"
                        % ", ".join(sorted({a["source"] for a in kept.values()})))
    if not manifest["animations"] and not errors:
        errors.append("no animations found; add a .aseprite, .png, .gif or .webp file")
    old_pic = os.path.join(out_dir, "pic")
    if os.path.isdir(old_pic):
        shutil.copytree(old_pic, os.path.join(staging, "pic"))
    # Keep the previous build's frames until the next build: the shell may still be loading
    # them while it rereads the index.
    if os.path.isdir(out_dir):
        prev = sorted(d for d in os.listdir(out_dir) if d.startswith("webp-"))
        if prev:
            shutil.move(os.path.join(out_dir, prev[-1]), os.path.join(staging, prev[-1]))
    write_json(os.path.join(staging, "manifest.json"), manifest)
    trash = out_dir + ".old.%d" % os.getpid()
    if os.path.isdir(out_dir):
        os.rename(out_dir, trash)
    os.rename(staging, out_dir)
    shutil.rmtree(trash, ignore_errors=True)
    log("built %s: %d animations%s" % (pid, len(manifest["animations"]),
                                       "".join("\n  error: " + e for e in errors) +
                                       "".join("\n  warning: " + w for w in warnings)))
    return True


def write_index(building=()):
    packs = []
    for pid in pack_ids():
        data, perr = read_pack_json(pid)
        entry = {"id": pid, "dir": pack_dir(pid), "pack": data or {}, "packError": perr,
                 "name": (data or {}).get("name") or pid, "author": (data or {}).get("author") or "",
                 "sources": sources(pid), "status": "unbuilt", "builtAt": 0, "canvas": None,
                 "animations": {}, "errors": [], "warnings": []}
        try:
            man = read_json(os.path.join(BUILDS, pid, "manifest.json"))
            entry.update(builtAt=man.get("builtAt", 0), webpDir=man.get("webpDir", "webp"), canvas=man.get("canvas"),
                         animations=man.get("animations", {}), errors=man.get("errors", []),
                         warnings=man.get("warnings", []))
            if pid in building:
                entry["status"] = "building"
            elif man.get("stamp") != stamp(pid):
                entry["status"] = "stale"
            else:
                entry["status"] = "ok" if entry["animations"] else "error"
        except (OSError, ValueError):
            if pid in building:
                entry["status"] = "building"
        packs.append(entry)
    with Lock("index"):
        write_json(INDEX, {"version": VERSION, "updatedAt": int(time.time() * 1000),
                           "packsDir": DATA, "aseprite": bool(find_aseprite()), "packs": packs})


def build(ids, force=False):
    for pid in ids:
        if not os.path.isdir(pack_dir(pid)):
            shutil.rmtree(os.path.join(BUILDS, pid), ignore_errors=True)
            continue
        with Lock("build-" + pid):
            if not force and not needs_build(pid):
                continue
            write_index(building={pid})
            try:
                build_pack(pid, force)
            except Exception as e:
                log("build %s failed: %s" % (pid, e))
    # Drop builds whose pack folder is gone.
    if os.path.isdir(BUILDS):
        live = set(pack_ids())
        for d in os.listdir(BUILDS):
            if not d.startswith(".") and d not in live:
                shutil.rmtree(os.path.join(BUILDS, d), ignore_errors=True)
    for f in os.listdir(CACHE):
        if f.startswith(".build-") and f.endswith(".lock") and f[7:-5] not in pack_ids():
            try:
                os.remove(os.path.join(CACHE, f))
            except OSError:
                pass
    write_index()


def needs_build(pid):
    try:
        return read_json(os.path.join(BUILDS, pid, "manifest.json")).get("stamp") != stamp(pid)
    except (OSError, ValueError):
        return True


# ------------------------------------------------------------------ commands

def cmd_init(quiet=False):
    """Create the data folder and a default pack on first run."""
    os.makedirs(DATA, exist_ok=True)
    os.makedirs(BUILDS, exist_ok=True)
    if not pack_ids() and os.path.isfile(TEMPLATE):
        d = os.path.join(DATA, "default")
        os.makedirs(d)
        if find_aseprite() or not os.path.isfile(TEMPLATE_PNG):
            shutil.copy2(TEMPLATE, os.path.join(d, "buddy.aseprite"))
        else:
            shutil.copy2(TEMPLATE_PNG, os.path.join(d, "buddy.png"))
            shutil.copy2(os.path.splitext(TEMPLATE_PNG)[0] + ".json", os.path.join(d, "buddy.json"))
        if os.path.isfile(TEMPLATE_PACK):
            shutil.copy2(TEMPLATE_PACK, os.path.join(d, "pack.json"))
        else:
            write_json(os.path.join(d, "pack.json"), {"name": "Default"})
        log("created the default pack from the template")
    elif not quiet:
        log("packs: %s" % (", ".join(pack_ids()) or "none"))


BLANK_LUA = """
local s = Sprite(tonumber(app.params.w), tonumber(app.params.h), ColorMode.RGB)
s.layers[1].name = "buddy"
local tag = s:newTag(1, 1)
tag.name = "idle"
s.frames[1].duration = 0.1
s:saveAs(app.params.out)
"""


def default_canvas():
    """The recommended canvas size, from the default config's sprite block."""
    try:
        sprite = read_json(os.path.join(PLUGIN, "assets", "config.json")).get("sprite") or {}
    except (OSError, ValueError):
        sprite = {}
    return int(sprite.get("width") or 128), int(sprite.get("height") or 72)


def blank_aseprite(path):
    """An empty RGB canvas at the recommended size, with one frame tagged "idle"."""
    ase = find_aseprite()
    if not ase:
        raise PackError("Aseprite not found; set ASEPRITE=/path/to/aseprite")
    w, h = default_canvas()
    with tempfile.NamedTemporaryFile("w", suffix=".lua", delete=False) as fh:
        fh.write(BLANK_LUA)
        script = fh.name
    try:
        r = subprocess.run([ase, "-b", "--script-param", "w=%d" % w, "--script-param", "h=%d" % h,
                            "--script-param", "out=" + path, "--script", script], capture_output=True, text=True)
    finally:
        os.remove(script)
    if r.returncode != 0 or not os.path.isfile(path):
        raise PackError("Aseprite could not create a blank sprite: %s" % (r.stderr or r.stdout).strip())


def cmd_new(name, src=None):
    name = name.strip()
    if not name:
        raise PackError("a pack needs a name")
    pid = unique_id(name)
    d = os.path.join(DATA, pid)
    if src:
        shutil.copytree(pack_dir(src), d)
        data, _ = read_pack_json(pid)
        data = dict(data or {}, name=name)
    else:
        os.makedirs(d)
        try:
            if find_aseprite():
                blank_aseprite(os.path.join(d, pid + ".aseprite"))
            else:
                # No Aseprite: a blank one-frame idle strip that any pixel-art editor can open
                w, h = default_canvas()
                Image.new("RGBA", (w, h)).save(os.path.join(d, "idle.png"))
        except PackError:
            shutil.rmtree(d, ignore_errors=True)
            raise
        data = {"name": name, "author": getpass.getuser()}
    write_json(os.path.join(d, "pack.json"), data)
    build([pid])
    print(pid)


def cmd_delete(pid):
    d = pack_dir(pid)
    if not os.path.isdir(d):
        raise PackError("no pack %s" % pid)
    os.makedirs(TRASH, exist_ok=True)
    dest = os.path.join(TRASH, "%s-%s" % (pid, time.strftime("%Y%m%d-%H%M%S")))
    shutil.move(d, dest)
    shutil.rmtree(os.path.join(BUILDS, pid), ignore_errors=True)
    write_index()
    log("moved to %s" % dest)


def cmd_save(pid, text):
    data = json.loads(sys.stdin.read() if text == "-" else text)
    if not isinstance(data, dict):
        raise PackError("pack.json must be an object")
    if not os.path.isdir(pack_dir(pid)):
        raise PackError("no pack %s" % pid)
    write_json(os.path.join(pack_dir(pid), "pack.json"), data)
    write_index()


def cmd_icons(pid, waiting, success, error):
    """Notification icons: first frame of the work-status animations, trimmed and scaled up."""
    pack_dir(pid)  # rejects ids like "../x", which would write outside BUILDS
    out = os.path.join(BUILDS, pid, "pic")
    os.makedirs(out, exist_ok=True)
    for icon, anim in (("approval", waiting), ("done", success), ("error", error)):
        src = os.path.join(BUILDS, pid, webp_dir_of(pid), anim_file(anim)) if anim else ""
        if not anim or not os.path.isfile(src):
            continue
        img = Image.open(src)
        img.seek(0)
        frame = img.convert("RGBA")
        box = frame.getchannel("A").getbbox()
        if box:
            frame = frame.crop(box)
        frame = frame.resize((frame.width * 4, frame.height * 4), Image.Resampling.NEAREST)
        frame.save(os.path.join(out, "notify-%s.png" % icon))


def webp_dir_of(pid):
    try:
        return read_json(os.path.join(BUILDS, pid, "manifest.json")).get("webpDir") or "webp"
    except (OSError, ValueError):
        return "webp"


def cmd_aseprite(pid):
    files = [os.path.join(pack_dir(pid), s["file"]) for s in sources(pid) if s["format"] == "aseprite"]
    if not files:
        raise PackError("this pack has no .aseprite file")
    ase = find_aseprite()
    if not ase:
        raise PackError("Aseprite not found; set ASEPRITE=/path/to/aseprite")
    subprocess.Popen([ase] + files, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ------------------------------------------------------------------ drawings
# A drawing is a PNG sheet with the simple JSON sidecar (the template's PNG copy of Goop).

DRAWING_COLS = 16


def write_drawing(d, name, w, h, anims):
    """anims: [(name, frames, durations)]. Writes NAME.png and NAME.json side by side."""
    frames, spec = [], {}
    for anim, imgs, ms in anims:
        spec[anim] = {"from": len(frames), "to": len(frames) + len(imgs) - 1, "durations": ms}
        frames.extend(imgs)
    if not frames:
        raise PackError("nothing to save: the drawing has no frames")
    cols = min(len(frames), DRAWING_COLS)
    sheet = Image.new("RGBA", (cols * w, math.ceil(len(frames) / cols) * h))
    for i, f in enumerate(frames):
        sheet.paste(f, ((i % cols) * w, (i // cols) * h))
    data = {"frameWidth": w, "frameHeight": h, "animations": spec}
    stem = os.path.splitext(name)[0]
    # Both files land by rename, so the watcher never builds a half-written sheet
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-", suffix=".png")
    os.close(fd)
    sheet.save(tmp)
    os.chmod(tmp, 0o644)
    write_json(os.path.join(d, stem + ".json"), data)
    os.replace(tmp, os.path.join(d, name))


def cmd_template_png():
    """Export the default pack's template as a PNG drawing, for installs without Aseprite."""
    with tempfile.TemporaryDirectory(prefix="pixel-buddy-") as tmp:
        anims = load_aseprite(TEMPLATE, find_aseprite(), tmp)
    w = max(f.width for fr, _ in anims.values() for f in fr)
    h = max(f.height for fr, _ in anims.values() for f in fr)
    write_drawing(os.path.dirname(TEMPLATE_PNG), os.path.basename(TEMPLATE_PNG), w, h,
                  [(n, fr, ms) for n, (fr, ms) in anims.items()])
    log("wrote %s (%d animations)" % (TEMPLATE_PNG, len(anims)))


def die_with_parent():
    """In the child: get SIGTERM when the watcher dies, even if it is killed outright."""
    try:
        import ctypes
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except OSError:
        pass


def cmd_watch():
    """Rebuild a pack shortly after any of its files changes. Runs for the shell's lifetime."""
    cmd_init(quiet=True)
    build(pack_ids())
    def start():
        return subprocess.Popen(["inotifywait", "-m", "-r", "-q", "-e", "close_write,create,delete,move",
                                 "--format", "%w%f", DATA], stdout=subprocess.PIPE, bufsize=0,
                                preexec_fn=die_with_parent)
    procs = [start()]
    # The shell stops the watcher with SIGTERM on reloads; take inotifywait down with it.
    signal.signal(signal.SIGTERM, lambda *_: (procs[0].terminate(), sys.exit(0)))
    pending = {}  # id -> [needs build, deadline]
    # Read the pipe raw: a buffered readline() can pull several events into Python's buffer
    # while select() keeps waiting on the empty pipe, stranding them until the next change.
    fd, buf = procs[0].stdout.fileno(), b""
    rewatch = False
    while True:
        now = time.monotonic()
        timeout = max(0, min(v[1] for v in pending.values()) - now) if pending else None
        ready, _, _ = select.select([fd], [], [], timeout)
        if ready:
            chunk = os.read(fd, 65536)
            if not chunk:
                sys.exit("inotifywait stopped")
            buf += chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                rel = os.path.relpath(os.fsdecode(line), DATA)
                parts = rel.split(os.sep)
                pid, name = parts[0], parts[-1]
                if pid.startswith(".") or not ID_RE.match(pid) or name.startswith(".") or name.endswith("~"):
                    continue
                if len(parts) > 2:
                    continue  # sub-folders are not part of a pack
                ext = os.path.splitext(name)[1].lower()
                rebuild = len(parts) == 1 or (name != "pack.json" and (ext in SOURCE_EXT or ext == ".json"))
                # inotifywait -r only watches folders created inside the tree, not moved-in ones
                if len(parts) == 1:
                    rewatch = True
                cur = pending.get(pid, [False, 0])
                pending[pid] = [cur[0] or rebuild, time.monotonic() + 1.0]
            continue
        if rewatch:
            rewatch = False
            procs[0].terminate()
            procs[0].wait()
            procs[0] = start()
            fd, buf = procs[0].stdout.fileno(), b""
        now = time.monotonic()
        due = [pid for pid, v in pending.items() if v[1] <= now]
        for pid in due:
            rebuild, _ = pending.pop(pid)
            try:
                if rebuild:
                    build([pid])
                else:
                    write_index()
            except Exception as e:
                log("watch: %s: %s" % (pid, e))
        if due:
            build(pack_ids())  # catches anything that changed while inotifywait restarted


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    try:
        if cmd == "init":
            cmd_init()
            write_index()
        elif cmd == "index":
            write_index()
        elif cmd == "build":
            force = "--force" in args
            ids = [a for a in args if not a.startswith("--")]
            build(pack_ids() if "--all" in args or not ids else ids, force)
        elif cmd == "new" and len(args) == 1:
            cmd_new(args[0])
        elif cmd == "duplicate" and len(args) == 2:
            cmd_new(args[1], src=args[0])
        elif cmd == "delete" and len(args) == 1:
            cmd_delete(args[0])
        elif cmd == "save" and len(args) == 2:
            cmd_save(args[0], args[1])
        elif cmd == "icons" and len(args) == 4:
            cmd_icons(*args)
        elif cmd == "aseprite" and len(args) == 1:
            cmd_aseprite(args[0])
        elif cmd == "watch":
            cmd_watch()
        elif cmd == "template-png":
            cmd_template_png()
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except PackError as e:
        print("pixel-buddy-pack: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
