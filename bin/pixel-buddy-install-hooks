#!/usr/bin/env bash
# Hooks pixel-buddy-hook into Claude Code (~/.claude/settings.json) and Codex (~/.codex/hooks.json).
# Idempotent: removes existing pixel-buddy-hook entries before adding; backs up each file as <file>.bak-pixel-buddy-<timestamp> before changing it.
#
# Usage: pixel-buddy-install-hooks [--uninstall] [--claude-only | --codex-only]
#        pixel-buddy-install-hooks --status   (JSON: whether each agent is installed and hooked up)
set -euo pipefail

HOOK=$(cd "$(dirname "$0")" && pwd)/pixel-buddy-hook
CLAUDE_SETTINGS=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
CODEX_HOOKS=${CODEX_HOME:-$HOME/.codex}/hooks.json

CLAUDE_EVENTS='["UserPromptSubmit","PreToolUse","PostToolUse","PostToolUseFailure","PermissionRequest","Elicitation","Notification","Stop","StopFailure","SessionEnd"]'
CODEX_EVENTS='["UserPromptSubmit","PreToolUse","PostToolUse","PermissionRequest","Stop","SessionEnd"]'

mode=install
targets="claude codex"
for arg in "$@"; do
  case $arg in
    --uninstall) mode=uninstall ;;
    --status) mode=status ;;
    --claude-only) targets=claude ;;
    --codex-only) targets=codex ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

# $1 = agent command, $2 = its config folder, $3 = hooks file
agent_status() {
  local installed=false connected=false
  if command -v "$1" >/dev/null 2>&1 || [[ -d $2 ]]; then installed=true; fi
  if [[ -s $3 ]] && jq -e '[.hooks // {} | .[][]?.hooks[]?.command // ""] | any(test("pixel-buddy-hook"))' "$3" >/dev/null 2>&1; then
    connected=true
  fi
  printf '{"installed":%s,"connected":%s}' "$installed" "$connected"
}

if [[ $mode == status ]]; then
  printf '{"claude":%s,"codex":%s}\n' \
    "$(agent_status claude "$(dirname "$CLAUDE_SETTINGS")" "$CLAUDE_SETTINGS")" \
    "$(agent_status codex "$(dirname "$CODEX_HOOKS")" "$CODEX_HOOKS")"
  exit 0
fi

# $1 = file, $2 = agent name, $3 = event list JSON
patch_file() {
  local file=$1 agent=$2 events=$3
  # A symlinked settings file (stow, chezmoi…) is edited where it points, so the link stays
  file=$(readlink -f "$file")
  mkdir -p "$(dirname "$file")"
  [[ -s $file ]] || echo '{}' > "$file"

  # Temp file next to the target, so the final mv is an atomic rename; removed if jq fails
  local tmp
  tmp=$(mktemp "$file.pixel-buddy-XXXXXX")
  # The hook path is quoted for the shell that runs it, in case it contains spaces
  jq --arg cmd "$(printf '%q' "$HOOK") $agent" --argjson events "$events" --arg mode "$mode" '
    # First remove every pixel-buddy-hook entry, then drop matcher groups and events left empty.
    # Entries that aren'"'"'t lists of matcher groups with a hooks list are left exactly as they are.
    .hooks = ((.hooks // {})
      | with_entries(if (.value | type) == "array" then .value = [.value[]
          | if type == "object" and (.hooks | type) == "array" then
              (.hooks = [.hooks[] | select((.command? // "") | tostring | test("pixel-buddy-hook") | not)]
               | select(.hooks | length > 0))
            else . end]
          else . end)
      | with_entries(select(.value != [])))
    | if $mode == "install" then
        reduce $events[] as $e (.;
          .hooks[$e] = ((.hooks[$e] // []) + [{ hooks: [{ type: "command", command: $cmd, timeout: 5 }] }]))
      else . end
    | if (.hooks | length) == 0 then del(.hooks) else . end
  ' "$file" > "$tmp" || { rm -f "$tmp"; echo "couldn't update $file (is it valid JSON?)" >&2; exit 1; }
  chmod --reference="$file" "$tmp"
  cp -p "$file" "$file.bak-pixel-buddy-$(date +%Y%m%d%H%M%S)"
  mv "$tmp" "$file"
  echo "$mode: $file"
}

for t in $targets; do
  case $t in
    claude) patch_file "$CLAUDE_SETTINGS" claude "$CLAUDE_EVENTS" ;;
    codex) patch_file "$CODEX_HOOKS" codex "$CODEX_EVENTS" ;;
  esac
done
