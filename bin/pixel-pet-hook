#!/usr/bin/env bash
# Claude Code / Codex hook 桥接：把 hook 事件转发给 pixel-pet（Omarchy 插件或独立模式实例）。
# 用法（hooks 配置里的 command）：pixel-pet-hook claude | pixel-pet-hook codex
#
# 约束：
# - stdout 不输出任何内容（UserPromptSubmit / SessionStart 的 stdout 会被注入模型上下文）；
# - 始终 exit 0，且立即返回：发送放到后台，不拖慢 agent。
# - PIXEL_PET_INTERNAL=1 时直接退出：宠物自己调用 claude -p / codex exec 时不回灌事件。
# - 事件内容（提问、工具参数、回复摘录）不放进任何命令行参数：进程参数对本机所有用户可见。
#   事件经管道交给 socat，写进宠物监听的 Unix socket；socat 的参数里只有 socket 路径。

[[ ${PIXEL_PET_INTERNAL:-} == 1 ]] && exit 0
agent=${1:-claude}
payload=$(cat)

# 与 EventServer.qml 一致；宠物没在运行（没有 socket）或没装 socat 时什么都不做
sock=${XDG_RUNTIME_DIR:-/run/user/$UID}/pixel-pet/events.sock
[[ -S $sock ]] && command -v socat >/dev/null || exit 0

# 发事件的终端是否在前台：从本进程沿父进程链向上，看能否碰到 Hyprland 当前窗口的 pid
focused=false
active_pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty' 2>/dev/null)
if [[ $active_pid =~ ^[0-9]+$ ]]; then
  pid=$$
  while [[ $pid =~ ^[0-9]+$ ]] && (( pid > 1 )); do
    if [[ $pid == "$active_pid" ]]; then focused=true; break; fi
    # /proc/<pid>/stat 是 "pid (comm) state ppid ..."，comm 可能含空格和括号：从最后一个 ") " 之后取 ppid
    { read -r stat < "/proc/$pid/stat"; } 2>/dev/null || break
    read -r _ pid _ <<<"${stat##*) }"
  done
fi

# 只挑需要的字段：tool_input / tool_response 可能很大
event=$(jq -c --arg agent "$agent" --argjson focused "$focused" '{
  agent: $agent,
  event: (.hook_event_name // ""),
  session: (.session_id // ""),
  cwd: (.cwd // ""),
  tool: (.tool_name // ""),
  notificationType: (.notification_type // ""),
  message: ((.message // .error // "") | tostring | .[0:200]),
  # 工具参数摘要：命令 / 文件路径 / 搜索词等，取第一行前 120 字
  detail: ((.tool_input // {})
    | if type == "object" then (.command // .cmd // .file_path // .path // .pattern // .url // .query // .description // "") else . end
    | if type == "array" then map(tostring) | join(" ") else tostring end
    | (split("\n")[0] // "") | .[0:120]),
  # 用户这一轮的请求（步骤总结用），只在 UserPromptSubmit 时带，截前 300 字
  prompt: (if .hook_event_name == "UserPromptSubmit" then ((.prompt // "") | tostring | .[0:300]) else "" end),
  # 会话记录路径（stepSummary.mode = transcript 时宠物自己去读）和 Stop 时的最后一条回复
  transcript: (.transcript_path // ""),
  lastMessage: ((.last_assistant_message // "") | tostring | .[0:2000]),
  focused: $focused
}' 2>/dev/null <<<"$payload") || exit 0

# 一行 JSON。printf 是 bash 内建命令，事件不会出现在任何进程的参数里。
# shut-none + 双向模式：发完不半关闭，等宠物读完一行后由宠物断开（-t 2 兜底），
# 否则 Quickshell 会为每次"对端先断开"记一条警告日志。
(
  printf '%s\n' "$event" | socat -t 2 - "UNIX-CONNECT:$sock,shut-none"
) </dev/null >/dev/null 2>&1 &
disown
exit 0
